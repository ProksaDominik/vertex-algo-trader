# Copy this file to `.env` and fill in your MT5 credentials.
# `.env` is gitignored so your credentials will not be committed.
#
# From your MT5 title bar you should see: "12345678 - ICMarketsEU-MT5-5 - Netting"
# => MT5_LOGIN = 12345678
# => MT5_SERVER = ICMarketsEU-MT5-5

MT5_LOGIN=12345678
MT5_PASSWORD=paste_your_master_password_here
MT5_SERVER=ICMarketsEU-MT5-5

# Optional — set only if Python is finding the wrong MT5 install.
# Right-click your MT5 shortcut > Properties > "Target" field to see the exact path.
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
